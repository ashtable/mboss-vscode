{
  "name": "mboss-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.0",
  "private": true,
  "publisher": "mboss",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashtable/mboss-vscode"
  },
  "engines": {
    "node": "24.18",
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "l10n": "./l10n",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "mboss.newProject",
        "title": "%commands.newProject.title%",
        "category": "%commands.category%"
      },
      {
        "command": "mboss.openRuns",
        "title": "%commands.openRuns.title%",
        "category": "%commands.category%"
      },
      {
        "command": "mboss.generateCode",
        "title": "%commands.generateCode.title%",
        "category": "%commands.category%"
      },
      {
        "command": "mboss.openAgentSidebar",
        "title": "%commands.openAgentSidebar.title%",
        "category": "%commands.category%"
      },
      {
        "command": "mboss.chooseCodingAgent",
        "title": "%commands.chooseCodingAgent.title%",
        "category": "%commands.category%"
      },
      {
        "command": "mboss.startStack",
        "title": "%commands.startStack.title%",
        "category": "%commands.category%"
      },
      {
        "command": "mboss.stopStack",
        "title": "%commands.stopStack.title%",
        "category": "%commands.category%"
      },
      {
        "command": "mboss.runWorkflow",
        "title": "%commands.runWorkflow.title%",
        "category": "%commands.category%"
      },
      {
        "command": "_mboss.refreshRuns#sideBar",
        "title": "%commands.refreshRuns.title%",
        "category": "%commands.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "_mboss.startStack#sideBar",
        "title": "%commands.startStack.title%",
        "category": "%commands.category%",
        "icon": "$(play)"
      },
      {
        "command": "_mboss.stopStack#sideBar",
        "title": "%commands.stopStack.title%",
        "category": "%commands.category%",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "_mboss.refreshRuns#sideBar",
          "when": "false"
        },
        {
          "command": "_mboss.startStack#sideBar",
          "when": "false"
        },
        {
          "command": "_mboss.stopStack#sideBar",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "_mboss.refreshRuns#sideBar",
          "when": "view == mboss.runs",
          "group": "navigation@1"
        },
        {
          "command": "_mboss.startStack#sideBar",
          "when": "view == mboss.runs && !mboss.stackUp",
          "group": "navigation@2"
        },
        {
          "command": "_mboss.stopStack#sideBar",
          "when": "view == mboss.runs && mboss.stackUp",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mboss",
          "title": "%viewsContainers.mboss.title%",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "mboss": [
        {
          "type": "webview",
          "id": "mboss.agentSidebar",
          "name": "%views.agentSidebar.name%"
        },
        {
          "type": "webview",
          "id": "mboss.runs",
          "name": "%views.runs.name%"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "mboss.agent.id": {
          "type": "string",
          "enum": [
            "claude-code",
            "codex",
            "gemini",
            "custom"
          ],
          "enumDescriptions": [
            "%configuration.agent.id.claudeCode%",
            "%configuration.agent.id.codex%",
            "%configuration.agent.id.gemini%",
            "%configuration.agent.id.custom%"
          ],
          "description": "%configuration.agent.id.description%",
          "scope": "resource"
        },
        "mboss.agent.command": {
          "type": "string",
          "default": "",
          "description": "%configuration.agent.command.description%",
          "scope": "resource"
        },
        "mboss.agent.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.agent.args.description%",
          "scope": "resource"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "mboss.workflowCanvas",
        "displayName": "%customEditors.workflowCanvas.displayName%",
        "selector": [
          {
            "filenamePattern": "**/.mboss/workflows/*.workflow.json"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build:mcp": "npm --prefix mboss-mcp-server ci && npm --prefix mboss-mcp-server run build:bundle",
    "build": "npm run build:mcp && node src/build.ts",
    "package": "npm run build && vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:webview": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "tsc --noEmit && eslint . && prettier --check ."
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@dbos-inc/dbos-sdk": "^4.27.6",
    "@types/node": "^24.13.3",
    "@xyflow/react": "^12.11.6",
    "elkjs": "^0.12.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-morph": "^28.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
